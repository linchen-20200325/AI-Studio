# see — 環境變數範例（只放鍵名，不放值；複製為 .env 後填寫，.env 已被 gitignore）
# 必要的只有 SEE_MODELS_DIR（用到 SD1.5／Kokoro／checkpoint 時）；其餘皆有預設。
# 檢查目前設定：python -m see.app.cli doctor（只讀；不會替你寫永久環境變數）。
# D-065：machine-specific 設定（模型目錄、workspace、ffmpeg、字型、TTS 裝置）主要放專案本機設定檔 see.local.json：
#   python -m see.app.cli config set models_dir "E:\AI\models"
# 優先序：環境變數 > see.local.json > 程式預設。本檔的環境變數仍有效且優先。
# 注意：Phase 0 不自動載入 .env；請先 export（或用 direnv / `set -a; . ./.env; set +a`）。

# 工作區根目錄（所有 project 產物放這裡；預設 ./workspace）
SEE_WORKSPACE=./workspace

# Provider 選擇（Phase 0 預設皆為免費本機方案）
SEE_LLM_PROVIDER=mock
SEE_IMAGE_PROVIDER=placeholder   # placeholder | auto | diffusers（auto：本機有權重就用 diffusers，否則 placeholder）
SEE_IMAGE_MODEL_PRESET=sd15   # sd15 | flux-schnell（DG-8：GTX 1650 4GB 採 sd15）
SEE_IMAGE_MODEL_PATH=            # 已下載的模型資料夾（留空則用 SEE_MODELS_DIR/<preset>；絕不自動下載）
SEE_MODELS_DIR=./models          # 模型存放處（已 gitignore；建議放大容量磁碟，例如 D:\\ai-models）
SEE_VIDEO_PROVIDER=kenburns
SEE_TTS_PROVIDER=auto          # auto | espeak | silent | edge
SEE_AUDIO_PROVIDER=null
SEE_LIPSYNC_PROVIDER=null

# 字幕字型（fontconfig 名稱；留空則自動偵測 CJK 字型）
SEE_SUBTITLE_FONT=

# 以下為未來 PAID / FREE_TIER Provider 預留，Phase 0 不使用。
# 任何 PAID Provider 執行前都需要人工核准（見 PROJECT_RULES.md §1）。
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# ELEVENLABS_API_KEY=
