# see — 環境變數範例（只放鍵名，不放值；複製為 .env 後填寫，.env 已被 gitignore）

# 工作區根目錄（所有 project 產物放這裡；預設 ./workspace）
SEE_WORKSPACE=./workspace

# Provider 選擇（Phase 0 預設皆為免費本機方案）
SEE_LLM_PROVIDER=mock
SEE_IMAGE_PROVIDER=placeholder
SEE_VIDEO_PROVIDER=kenburns
SEE_TTS_PROVIDER=auto          # auto | espeak | silent | edge
SEE_AUDIO_PROVIDER=null
SEE_LIPSYNC_PROVIDER=null

# 字幕字型（fontconfig 名稱；留空則自動偵測 CJK 字型）
SEE_SUBTITLE_FONT=

# 以下為未來 PAID / FREE_TIER Provider 預留，Phase 0 不使用。
# 任何 PAID Provider 執行前都需要人工核准（見 PROJECT_RULES.md §1）。
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# ELEVENLABS_API_KEY=
